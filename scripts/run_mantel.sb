#!/bin/bash --login
#SBATCH --job-name=mantel
#SBATCH --time=08:00:00
#SBATCH --cpus-per-task=1
#SBATCH --mem=32G
#SBATCH --output=/mnt/gs21/scratch/renaldse/AlphaFold3/logs/mantel_%j.out
#SBATCH --error=/mnt/gs21/scratch/renaldse/AlphaFold3/logs/mantel_%j.err

set -euo pipefail

module purge
module load Python/3.11.3-GCCcore-12.3.0

pip install mantel --quiet --user

cd /mnt/gs21/scratch/renaldse/AlphaFold3/RMSD

python mantel_af3_top_confidence.py --mode allatom
python mantel_af3_top_confidence.py --mode ca
